# 复制为 .env.local 后填写真实值；.env.local 不会被提交。
# 部署到 Vercel 等平台时，在平台的环境变量里配置同样这几项。

NEXT_PUBLIC_GITHUB_OWNER=你的GitHub用户名
NEXT_PUBLIC_GITHUB_REPO=你的仓库名
NEXT_PUBLIC_GITHUB_BRANCH=main
NEXT_PUBLIC_GITHUB_APP_ID=你的GitHubAppID

# 图床仓库：上传图片时额外保存一份到 iusine/Image-bed（按分类目录存放）。
# 默认值就是下面三项，通常不用改；GitHub App 需要同时安装到这个仓库。
NEXT_PUBLIC_PICBED_OWNER=iusine
NEXT_PUBLIC_PICBED_REPO=Image-bed
NEXT_PUBLIC_PICBED_BRANCH=main

# 加密浏览器会话里缓存的 .pem 私钥用的口令。
# 随便生成一串随机字符，不要提交到仓库，也不要复用旧口令。
NEXT_PUBLIC_GITHUB_ENCRYPT_KEY=换成一串随机字符串

# ---------------------------------------------------------------
# 留言墙（/message）线上落库用，只配在部署平台的环境变量里，不要提交。
# 开发环境不需要：留言会直接写进 public/message/list.json。
# 生产环境把 GitHub App 的 .pem 内容整段贴进来（保留换行），访客的留言
# 就会由服务端自动提交到仓库；不配的话页面会提示直接发邮件给站主。
# ---------------------------------------------------------------
# GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n"
# GITHUB_APP_ID=你的GitHubAppID
# GITHUB_OWNER=iusine
# GITHUB_REPO=Blog-Yihe
# GITHUB_BRANCH=main

